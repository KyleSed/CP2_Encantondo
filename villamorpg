    os.system('clear')
    print('~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~')
    print("        ~~Welcome to Encatondo, a Realistic Pinoy Game (RPG)~~        \n")
