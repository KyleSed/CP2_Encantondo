    print("3. Use commands to interact with the environment and characters, some common commands are 'yap', 'fight' and 'use'.")
    print("4. Your goal is to explore the town and discover different commands that you could use on your journey.")
    print("\nType 'return' to go back to the help menu.")
    print('===============================================================================')
    choice = input("> ")
    if choice.lower() == ("return"):
        help_menu()

def help_menu_options():
    choice = input("> ")
    if choice.lower() == ("how to play"):
        how_to_play()
    elif choice.lower() == ("return"):
        title_screen()
    while choice.lower() not in valid_help_options:
        print("Invalid command. Please try again.")
        choice = input("> ")
    if choice.lower() == ("how to play"):
        how_to_play()
    elif choice.lower() == ("return"):
        title_screen()

