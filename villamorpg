#PLAYER
class Player:
    def __init__(player):
        player.location = 'e4'
        player.game_over = False

playerko = Player()

#UI
def title_screen_options():
    option = input("> ")
    if option.lower() == ("play"):
        start_game()
    elif option.lower() == ("help"):
        help_menu()
    elif option.lower() == ("quit"):
        sys.exit()
    while option.lower() not in valid_options:
        print("Invalid command. Please try again.")
        option = input("> ")
        if option.lower() == ("play"):
            start_game()
        elif option.lower() == ("help"):
            help_menu()
        elif option.lower() == ("quit"):
            sys.exit()

def how_to_play():
    os.system('cls')
    print('===============================================================================')
