#UI
def border():
    print('===============================================================================')

def title_screen_options():
    while True:
        option = input("> ").lower()

        if option == "new game":
            ask_name()
            start_game()
            break
        elif option == "load game":
            load_game()
            break
        elif option == "help":
            help_menu()
