            print("Invalid command. Please try again.")

def ask_name():
    os.system('cls')
    border()
    print("                  ~~Sup, what should I call you homie?~~")
    border()

    playerko.name = input("> ")
    playerko.location = 'e4' 
    save_game()
    border()
    print(f"                  ~~Eyyo what's trippin', {playerko.name}!~~")
    border()

def load_game():
    global hp, stamina, strength, money, inventory

    try:
        file = open("C:\\Users\\Administrator\\Desktop\\savefile.txt", "r")
        lines = file.readlines()
        file.close()

        # Check if file is complete
        if len(lines) < 6:
            raise Exception("Corrupted save file")

        playerko.name = lines[0].strip()
        playerko.location = lines[1].strip()

        # Fix empty location
        if playerko.location not in zonemap:
            playerko.location = 'e4'

        hp = int(lines[2].strip() or 100)
        stamina = int(lines[3].strip() or 100)
        strength = int(lines[4].strip() or 10)
        money = int(lines[5].strip() or 0)

        inventory = lines[6].strip().split(',') if len(lines) > 6 else []

        border()
        print(f"                  ~~Sup {playerko.name}! Welcome back!~~")
        border()

    except:
        print("                  ~~Save file corrupted. Starting new game.~~")
        ask_name()
        return

    start_game()

